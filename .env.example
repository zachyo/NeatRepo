NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Server-only secret key (sb_secret_...). Never expose to the browser.
SUPABASE_SECRET_KEY=
# Only needed if you add client-side Supabase usage (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Encrypts the session cookie. 32+ random chars: openssl rand -base64 32
SESSION_SECRET=
# Encrypts stored GitHub tokens (AES-256-GCM). 32 bytes base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
